      ]
    },
    {
      "name": "GET /webhook/telegram-payment/status",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/webhook/telegram-payment/status",
          "host": ["{{baseUrl}}"],
          "path": ["webhook", "telegram-payment", "status"]
        },
        "description": "Проверка статуса webhook'а"
      },
      "response": [
        {
          "name": "Status Response",
          "originalRequest": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/webhook/telegram-payment/status",
              "host": ["{{baseUrl}}"],
              "path": ["webhook", "telegram-payment", "status"]
            }
          },
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "cookie": [],
          "body": "{\n  \"ok\": true,\n  \"message\": \"Payment webhook is active\",\n  \"timestamp\": \"2025-01-17T10:00:00.000Z\"\n}"
