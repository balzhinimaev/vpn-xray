  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "description": "Базовый URL сервера"
    },
    {
      "key": "telegramSecretToken",
      "value": "your-secret-token",
      "description": "Секретный токен для валидации подписи от Telegram"
    }
  ]
}
